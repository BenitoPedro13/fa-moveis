# Catalogue source. Only "local" is implemented (lib/catalog/source.local.ts, reads content/).
# "shopify" is phase 3 (spec-architecture.md §6) and has no implementation yet — setting it
# here does nothing until lib/catalog/source.shopify.ts exists.
CATALOG_SOURCE=local

# Absolute origin for every outbound URL: WhatsApp deep links, OG images, canonical tags,
# sitemap.xml, robots.txt. No trailing slash.
#
# Resolution order (content/loja.ts) — an empty value counts as unset at every step:
#   1. NEXT_PUBLIC_SITE_URL                          this variable
#   2. NEXT_PUBLIC_VERCEL_PROJECT_PRODUCTION_URL     Vercel, stable production host
#   3. NEXT_PUBLIC_VERCEL_URL                        Vercel, this deployment (previews)
#   4. http://localhost:3000                         local development
#
# On Vercel with VERCEL_ENV=production, falling through to localhost throws at build time
# rather than shipping localhost links inside WhatsApp messages. Production today is
# https://fa-moveis.vercel.app — see docs/tasks/TASK-verificacao-dispositivo.md.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
